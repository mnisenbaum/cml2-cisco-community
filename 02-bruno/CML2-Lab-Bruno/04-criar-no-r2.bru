meta {
  name: 04 - Criar no R2
  type: http
  seq: 4
}

post {
  url: {{base_url}}/labs/{{lab_id}}/nodes?populate_interfaces=true
  body: json
  auth: none
}

params:query {
  populate_interfaces: true
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

body:json {
  {
    "label": "R2",
    "node_definition": "iol-xe",
    "x": -240,
    "y": -320,
    "configuration": "hostname R2\nno ip domain lookup\n!\ninterface Loopback0\n ip address 2.2.2.2 255.255.255.0\n ip ospf 1 area 0\n!\ninterface Ethernet0/0\n ip address 10.1.2.2 255.255.255.0\n no shutdown\n ip ospf 1 area 0\n!\ninterface Ethernet0/1\n ip address 10.2.3.2 255.255.255.0\n no shutdown\n ip ospf 1 area 0\n!\nrouter ospf 1\n router-id 2.2.2.2\n passive-interface Loopback0\n!\nend\n"
  }
}

script:post-response {
  bru.setVar("r2_id", res.body.id);
}

assert {
  res.status: eq 200
}
