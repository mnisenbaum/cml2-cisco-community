meta {
  name: 05 - Criar no R3
  type: http
  seq: 5
}

post {
  url: {{base_url}}/labs/{{lab_id}}/nodes?populate_interfaces=true
  body: json
  auth: none
}

params:query {
  populate_interfaces: true
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

body:json {
  {
    "label": "R3",
    "node_definition": "iol-xe",
    "x": -40,
    "y": -120,
    "configuration": "hostname R3\nno ip domain lookup\n!\ninterface Loopback0\n ip address 3.3.3.3 255.255.255.0\n ip ospf 1 area 0\n!\ninterface Ethernet0/0\n ip address 10.3.4.3 255.255.255.0\n no shutdown\n ip ospf 1 area 0\n!\ninterface Ethernet0/1\n ip address 10.2.3.3 255.255.255.0\n no shutdown\n ip ospf 1 area 0\n!\nrouter ospf 1\n router-id 3.3.3.3\n passive-interface Loopback0\n!\nend\n"
  }
}

script:post-response {
  bru.setVar("r3_id", res.body.id);
}

assert {
  res.status: eq 200
}
