meta {
  name: 10 - Interfaces de R4
  type: http
  seq: 10
}

get {
  url: {{base_url}}/labs/{{lab_id}}/nodes/{{r4_id}}/interfaces?data=true&operational=false
  body: none
  auth: none
}

params:query {
  data: true
  operational: false
}

headers {
  Authorization: Bearer {{token}}
}

script:post-response {
  const byLabel = {};
  res.body.forEach((iface) => { byLabel[iface.label] = iface.id; });
  bru.setVar("r4_eth00", byLabel["Ethernet0/0"]);
  bru.setVar("r4_eth01", byLabel["Ethernet0/1"]);
}

assert {
  res.status: eq 200
}
