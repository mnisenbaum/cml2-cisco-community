meta {
  name: 06 - Criar no R4
  type: http
  seq: 6
}

post {
  url: {{base_url}}/labs/{{lab_id}}/nodes?populate_interfaces=true
  body: json
  auth: none
}

params:query {
  populate_interfaces: true
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

body:json {
  {
    "label": "R4",
    "node_definition": "iol-xe",
    "x": -240,
    "y": 80,
    "configuration": "hostname R4\nno ip domain lookup\n!\ninterface Loopback0\n ip address 4.4.4.4 255.255.255.0\n ip ospf 1 area 0\n!\ninterface Ethernet0/0\n ip address 10.3.4.4 255.255.255.0\n no shutdown\n ip ospf 1 area 0\n!\ninterface Ethernet0/1\n ip address 10.1.4.4 255.255.255.0\n no shutdown\n ip ospf 1 area 0\n!\nrouter ospf 1\n router-id 4.4.4.4\n passive-interface Loopback0\n!\nend\n"
  }
}

script:post-response {
  bru.setVar("r4_id", res.body.id);
}

assert {
  res.status: eq 200
}
