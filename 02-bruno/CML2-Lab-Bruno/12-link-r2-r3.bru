meta {
  name: 12 - Link R2 Ethernet0/1 -- R3 Ethernet0/1
  type: http
  seq: 12
}

post {
  url: {{base_url}}/labs/{{lab_id}}/links
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

body:json {
  {
    "src_int": "{{r2_eth01}}",
    "dst_int": "{{r3_eth01}}"
  }
}

assert {
  res.status: eq 200
}
