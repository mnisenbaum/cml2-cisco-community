# Modelo de credenciais -- preencha com os dados do SEU controller CML2,
# depois renomeie este arquivo para ".env" (sem o "-modelo").
# O ".env" nunca é commitado (está no .gitignore); este arquivo-modelo, sim.
CML_URL=https://SEU-CONTROLLER-AQUI
CML_USERNAME=usuario-generico
CML_PASSWORD=senha-generica
